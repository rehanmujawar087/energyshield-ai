# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider ---
# Which provider llm.py should use: "groq" (default) or "gemini"
LLM_PROVIDER=groq

# Groq (llama-3.3-70b)
GROQ_API_KEY=

# Gemini (alternative provider, swap via LLM_PROVIDER)
GEMINI_API_KEY=

# --- News / signal sources ---
# Optional: GDELT or RSS feed override; leave blank to use cached sample feed
NEWS_FEED_URL=

# --- Backend ---
# Host/port for local FastAPI dev server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Frontend ---
# Base URL the frontend uses to reach the backend API
VITE_API_BASE_URL=http://127.0.0.1:8000
